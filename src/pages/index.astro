---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";

import logoLandscape from "@images/nix-snowflake-hare-triskele-dark-blue.png";
import wegbeschreibungEingang from "@images/wegbeschreibung-eingang.jpg";
---

<Layout title="Nix Community Paderborn - NixCon 2025 Watch Party">
  <Image
    src={logoLandscape}
    alt="Nix Community Paderborn"
    class="w-full object-contain px-2 pt-10 lg:pt-20 lg:px-12 max-w-screen-md mx-auto"
  />
  <div
    class="flex flex-col gap-8 max-w-screen-md mx-auto pb-20 pt-4 px-4 lg:px-0"
  >
    <h1 class="text-center">Nix(OS) Community Paderborn</h1>
    <div>
      <h2 class="pb-4">Communication</h2>
      <ul class="list-image-flake list-inside">
        <li>
          Matrix Chat Room: <a href="https://matrix.to/#/#paderborn:nixos.org"
            >#paderborn:nixos.org</a
          >
        </li>
        <li>
          Mailing List: <a href="https://lists.uni-paderborn.de/mailman/listinfo/nix"
            >nix@lists.uni-paderborn.de</a
          >
        </li>
        <li>
          Questions? Contact the list admins: <a href="mailto:nix-owners@lists.uni-paderborn.de"
            >nix-owners@lists.uni-paderborn.de</a
          >
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h2>NixCon 2025 Watch Party</h2>
      <p>Date: 2025-09-05 (Friday)</p>
      <p>
        Location: C3PB - Westernmauer 12-16, 33098 Paderborn (directly at Westerntor)
      </p>
      <p>
        Registration: <a
          href="https://cryptpad.fr/form/#/2/form/view/uDQIVQTzI2OgNdxxHvUzY1nZSUYsDlllHB7rehCnpCw/"
          >Please let us know you'll participate.</a
        >
      </p>
      <p>Time: 09:30 - open end (after 18:00)</p>
      <ul class="list-image-flake list-inside">
        <li>09:30: Start of livestream watch party</li>
        <li>Throughout the day: Open discussion and exchange</li>
        <li>After 18:00: Open end with drinks and snacks</li>
      </ul>
      <h2>About the Event</h2>
      <p>
        Join us for a community watch party of the NixCon 2025 livestream from Switzerland! 
        This is a great opportunity to connect with other Nix enthusiasts, discuss what we're watching, 
        and share experiences. No prior Nix knowledge required - newcomers are welcome!
      </p>
      <Image src={wegbeschreibungEingang} alt="Directions to C3PB entrance" class="rounded-lg" />
      <h3>What is Nix, NixOS?</h3>
      <p>
        Nix is a functional package manager that makes software installations reproducible across systems. 
        NixOS builds on this foundation as a Linux distribution that manages configurations declaratively, 
        making it particularly stable, traceable, and flexible.
      </p>
    </div>

    <div class="flex flex-col gap-4">
      <h2>Past Events</h2>
      <h3>First Meetup - May 8, 2025</h3>
      <p>
        Our inaugural meetup took place at <a href="/locations/garage33">garage33</a> with an 
        introduction to Nix and NixOS. We had great discussions and established our community foundation.
      </p>
      <p>
        Protocol: <a href="https://pad.lassul.us/TYWK3FH9SgSScuryz40fMg#">Meeting notes from 2025-05-08</a>
      </p>
    </div>
  </div>
</Layout>
